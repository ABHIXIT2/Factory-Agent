# Factory Agent — Environment Variables Template
# Copy this to .env and fill in real values

# Required: Groq API (get from https://console.groq.com)
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Required: Telegram Bot Token (get from @BotFather)
TELEGRAM_BOT_TOKEN=123456789:ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghij

# Required: Supabase credentials (from https://supabase.com → project settings)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Optional: Google Gemini (set to enable as primary LLM; Groq becomes fallback)
GOOGLE_AI_STUDIO_KEY=

# Optional: Timezone (default: Asia/Kolkata)
TIMEZONE=Asia/Kolkata

# Optional: LLM Model Selection
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_MODEL_FAST=llama-3.1-8b-instant
GOOGLE_MODEL=gemini-2.0-flash

# Optional: Token Limits (for display/warnings only, not enforced)
GROQ_DAILY_TOKEN_LIMIT=100000
GOOGLE_DAILY_TOKEN_LIMIT=1000000

# Optional: Agent Loop Limits
MAX_ITERATIONS=5
CONTEXT_WINDOW=10

# Optional: Rate Limiting (per user, per window)
RATE_LIMIT_MESSAGES=20
RATE_LIMIT_WINDOW_SECONDS=60

# Optional: Session Cache
SESSION_TTL_SECONDS=3600
SESSION_MAX_USERS=10000
